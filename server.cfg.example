endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"

sv_hostname "Obelisk Framework"
sv_maxclients 48

# Get yours at https://keymaster.fivem.net
sv_licenseKey "changeme"

# oblsk_connector talks to the database via this convar (see oblsk_connector/server.lua).
# For MariaDB (default): mysql://obelisk:obelisk_password@mariadb:3306/fivem
# For Postgres: switch db_driver below to "postgres", point this at the
# postgres service instead, and run `docker compose --profile postgres up
# postgres fxserver` (not mariadb) — see docker-compose.yml.
set mysql_connection_string "mysql://obelisk:obelisk_password@mariadb:3306/fivem"

# "mysql" (default) or "postgres". Must match the connection string above.
# This convar is the ONLY thing that selects the driver — core no longer
# infers it from the connection string's scheme (mysql:// vs postgres://),
# and oblsk_connector never did. Setting mysql_connection_string to a
# postgres:// URL without also setting db_driver "postgres" here leaves
# core generating MySQL SQL against a Postgres-shaped connection string, so
# you must always set db_driver explicitly to switch dialects.
# postgres requires oblsk_connector — oxmysql/ghmattimysql/mysql-async are
# MySQL-only and Database.init() will fail fast if you mix them with postgres.
set db_driver "mysql"

# "local" (default) or "s3".
set storage_driver "local"

# local provider
set storage_local_path "storage"

# s3 provider (S3-compatible: AWS S3, MinIO, R2, Spaces, ...)
# set storage_s3_endpoint "https://s3.us-east-1.amazonaws.com"
# set storage_s3_bucket "obelisk-uploads"
# set storage_s3_key "changeme"
# set storage_s3_secret "changeme"
# set storage_s3_region "us-east-1"

# The port this server's own HTTP endpoint listens on - must match the
# port in endpoint_add_tcp/endpoint_add_udp above. Used by Storage.uploadUrl()
# so in-process resources (like screencapture's server-side upload exports)
# can POST back to this server's own /storage/upload endpoint.
set storage_http_port "30120"

# Max photos+videos a character's Gallery can hold across all albums.
set phone_gallery_max_items 200

# Date/number/currency formatting (core/shared/Settings.lua). All optional,
# defaults shown below.
# set date_format "YYYY-MM-DD"           # tokens: YYYY MM DD HH mm ss
# set number_decimal_sep "."
# set number_thousands_sep ","
# set currency_symbol "$"
# set currency_position "before"         # "before" or "after"
# set timezone_offset_minutes 0          # minutes offset from UTC, e.g. -300 for UTC-5

ensure oblsk_connector
ensure core

sv_enforceGameBuild 2802
set onesync on
